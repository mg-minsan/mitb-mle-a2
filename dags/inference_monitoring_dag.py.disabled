"""Triggered by data_processing_dag after both Gold branches succeed.

The processing_date conf is mandatory so a historical rerun cannot silently
score today's date. This DAG reuses the existing model; it does not train one.
"""

from datetime import datetime, timedelta

from airflow import DAG
from airflow.operators.bash import BashOperator


with DAG(
    dag_id="inference_monitoring_dag",
    description="Predict one processed application month, then save PSI results",
    default_args={
        "owner": "airflow",
        "depends_on_past": False,
        "retries": 1,
        "retry_delay": timedelta(minutes=5),
    },
    schedule=None,
    start_date=datetime(2024, 9, 1),
    end_date=datetime(2024, 12, 1),
    catchup=False,
    max_active_runs=1,
    # No schedule: unpausing allows parent-triggered runs, not automatic runs.
    is_paused_upon_creation=False,

) as dag:
    snapshot_env = {"SNAPSHOT_DATE": "{{ dag_run.conf['processing_date'] }}"}

    model_inference_start = BashOperator(
        task_id="model_inference_start",
        bash_command=(
            'cd /app && '
            'PYTHONPATH=/app python3 scripts/model_inference.py '
            '--snapshotdate "$SNAPSHOT_DATE" '
            '--model "credit_model_2024_09_01.pkl"'
        ),
        env=snapshot_env.copy(),
        append_env=True,
    )

    model_psi_monitoring = BashOperator(
        task_id="model_psi_monitoring",
        bash_command=(
            'cd /app && '
            'PYTHONPATH=/app python3 scripts/model_monitoring.py monitor '
            '--snapshotdate "$SNAPSHOT_DATE" '
            '--model "credit_model_2024_09_01.pkl"'
        ),
        env=snapshot_env.copy(),
        append_env=True,
    )

    model_inference_start >> model_psi_monitoring
